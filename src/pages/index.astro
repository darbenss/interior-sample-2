      </div>
    </div>
  </section>

  <script>
    /* ------------------------------------------------------------------
     * The services rail.
     *
     * Two jobs, and on most devices the second one never runs.
     *
     * 1. OPT THE LAYOUT IN. `rr-services--rail` is what turns the swipe
     *    carousel into a pinned, sideways-travelling rail. It is applied
     *    from script rather than by a media query because the rail needs two
     *    different drivers depending on the browser and both need the same
     *    layout — and because a visitor with no JS should get the carousel,
     *    which is a complete section, rather than a 210svh box whose
     *    contents never move.
     *
     * 2. DRIVE IT, BUT ONLY IF THE BROWSER CANNOT. Where `animation-timeline`
     *    is supported the rail is moved by the compositor straight off the
     *    scroll offset and nothing below this line ever executes again.
     *    Where it is not — iOS before Safari 26, which is most of the reason
     *    this exists — the same travel is computed here.
     *
     * WHAT THE FALLBACK COSTS PER FRAME: one subtraction, one clamp, one
     * transform write. It adds no scroll listener of its own (`rr:scroll` is
     * already emitted once per frame by smooth-scroll.ts, from Lenis or from
     * a rAF-coalesced native listener) and it reads no layout — every
     * measurement is cached and recomputed only on resize or a font swap.
     * ---------------------------------------------------------------- */
    const rrServices = document.querySelector<HTMLElement>('.rr-services');
    const rrViewport = rrServices?.querySelector<HTMLElement>('.rr-services__viewport');
    const rrRail = rrServices?.querySelector<HTMLElement>('.rr-services__rail');

    if (
      rrServices &&
      rrViewport &&
      rrRail &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      rrServices.classList.add('rr-services--rail');

      let start = 0;
      let travel = 1;
      let distance = 0;

      const progressAt = (y: number) => Math.min(1, Math.max(0, (y - start) / travel));

      const measure = () => {
        start = rrServices.getBoundingClientRect().top + window.scrollY;
        /* The pinned window: how far the page scrolls while the viewport is
           stuck. The same span the CSS `contain` range covers. */
        travel = Math.max(1, rrServices.offsetHeight - rrViewport.offsetHeight);
        distance = Math.max(0, rrRail.scrollWidth - rrViewport.clientWidth);
      };

      const paint = (y: number) => {
        rrRail.style.transform = `translate3d(${(-progressAt(y) * distance).toFixed(1)}px,0,0)`;
      };

      const onScroll = (event: WindowEventMap['rr:scroll']) => paint(event.detail.y);

      /* Take the rail off the compositor and drive it here instead. */
      const drive = () => {
        rrServices.classList.add('rr-services--driven');
        measure();
        paint(window.scrollY);
        window.addEventListener('rr:scroll', onScroll);
      };

      measure();

      if (!CSS.supports('animation-timeline', 'view()')) {
        drive();
      } else {
        /* TRUST THE COMPOSITOR, BUT VERIFY ONCE.

           CSS.supports() and @supports both answer the same question — does
           this declaration PARSE — and neither can tell us the timeline
           actually resolved. Where it does not, `both` fill parks the rail at
           translateX(0) and the section silently loses two of its three
           panels while looking like a perfectly ordinary page. That is the
           exact failure this whole fallback exists to prevent, so guessing
           from a parse test is not good enough.

           So: wait until the section is genuinely mid-travel, read the rail
           once, and if it has not moved, take over. One computed-style read,
           on one frame, on one element, and only ever once. */
        const audit = (event: WindowEventMap['rr:scroll']) => {
          const progress = progressAt(event.detail.y);
          if (progress < 0.12 || progress > 0.88) return;

          window.removeEventListener('rr:scroll', audit);

          const matrix = getComputedStyle(rrRail).transform;
          const x = matrix.startsWith('matrix')
            ? Math.abs(parseFloat(matrix.split(',')[4] ?? '0'))
            : 0;

          /* Anything under a pixel of travel at 12-88% through the section
             means the animation is not running. */
          if (x < 1) drive();
        };

        window.addEventListener('rr:scroll', audit);
      }

      /* The rail is sized by its type, and the webfont arrives late. */
      if (document.fonts?.ready) void document.fonts.ready.then(measure);

      let rrResizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(rrResizeTimer);
        rrResizeTimer = window.setTimeout(() => {
          measure();
          if (rrServices.classList.contains('rr-services--driven')) paint(window.scrollY);
        }, 150);
      });
    }
  </script>

  {/* --------------------------------------------------------- PORTFOLIO

      Curated Spaces and the standalone gallery, fused. They were two sections
      doing one job: the first sold the case studies, the second sold the
      photography, and a visitor had no way to tell they were about the same
      work. Now they are one movement on one ground — three project plates that
      lead somewhere, then a strip of detail photography that does not, under a
      single heading, with the second half explicitly labelled as detail so the
      hierarchy is stated rather than implied.

      TWO LAYOUTS, NEITHER OF THEM THE BROKEN GRID. The plates alternate left
      and right, which is a magazine spread; the detail strip is a plain even
      three-up. The asymmetric slot grid that used to be here still exists in
      global.css and is still used by /portfolio, where a filterable set of
      twenty projects genuinely needs it. */}
