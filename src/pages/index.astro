            data-reveal
            data-reveal-delay="90"
          >
            Three projects in full, and a few details from the rest. Every one of
            them started as a room somebody had stopped enjoying.
          </p>
        </div>
      </div>
    </div>

    {/* ------------------------------------------------------- THE PLATES */}
    <div class="rr-work__plates">
      {
        plates.map(({ project, image, widths, flip }, i) => (
          <a
            href={`/portfolio/${project.id}`}
            class:list={['rr-plate', flip && 'rr-plate--flip']}
          >
            {/* `overflow: clip` on the frame, never `hidden` — see the note in
