---
import { TIMELINE } from '@/components/preloader/timeline';

/* ---------------------------------------------------------------------------
 * Hero headline with a staggered WORD reveal — zero JavaScript.
 *
 * WHY THIS IS NOT AN ISLAND ANY MORE
 * The previous version was a React + Framer Motion island on `client:visible`.
 * The hero is above the fold, so the IntersectionObserver fired on mount and
 * the island hydrated during the exact 0-2000ms window the preloader is
 * drawing — react-dom (178 KB) plus the LazyMotion feature bundle (74 KB),
 * parsed and executed on the main thread while the preloader's
 * `stroke-dashoffset` animation needs that same thread to repaint every frame.
 * `stroke-dashoffset` is a PAINT property, not a compositor one, so the draw
 * stuttered for as long as hydration ran. This markup is the whole component.
 *
 * WHY THE REVEAL STARTS AT `fadeStart` AND NOT ON LOAD
 * The old island animated on mount — which is to say, entirely behind an opaque
 * overlay, where nobody ever saw it. The delay below is read from the same
 * TIMELINE the preloader uses, so the words rise as the title card lifts.
 * `html.rr-skip-preloader` (stamped in BaseLayout's head script for a repeat
 * view in the same session) drops the delay to zero.
 *
 * WHY WORD BY WORD, NOT LINE BY LINE
 * Each word is its own mask and rises on its own beat, so "Crafting ... Spaces
 * ... That ... Inspire." reads as a ladder rather than two blocks. `--rr-i` is
 * a running index across the line break, so the stagger never resets.
 *
 * WHY IT IS SAFE TO SHIP THE HIDDEN STATE
 * The rule that hides a word and the keyframe that reveals it are in the same
 * stylesheet — if one applies, so does the other. There is nothing left to fail
 * independently and leave an invisible headline.
 * ------------------------------------------------------------------------- */

export type Props = {
  /** Each string renders as its own line; words within it stagger in sequence. */
  lines: string[];
  class?: string;
};

const { lines, class: className = '' } = Astro.props;

/* Flatten to words carrying a running index, so the ladder continues across the
   line break instead of restarting at 0 on line two. */
let wordIndex = 0;
const rows = lines.map((line) => ({
  words: line.split(' ').map((word) => ({ word, i: wordIndex++ })),
}));
---

<h1 class={className} style={`--rr-hero-start:${TIMELINE.fadeStart}ms`}>
  {
    rows.map(({ words }) => (
      <span class="rr-hero__row">
        {words.map(({ word, i }, wi) => (
          <>
            {wi > 0 && ' '}
            {/* The mask. The inner span translates up from below its own bottom
                edge, so the word appears to rise out of the baseline. */}
            <span class="rr-hero__mask">
              <span class="rr-hero__word" style={`--rr-i:${i}`}>{word}</span>
            </span>
          </>
        ))}
      </span>
    ))
  }
</h1>

<style is:global>
  .rr-hero__row {
    display: block;
  }

  .rr-hero__mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  .rr-hero__word {
    display: inline-block;
    /* text-display-lg sets a tight line-height against Playfair Display, whose
       descenders (the loop on "g", the tail on "p") extend past the line box.
       `.rr-hero__mask` sizes to this element's box with `overflow: hidden`, so a
       unitless ratio here keeps the descender from being sliced flat at both of
       text-display-lg's breakpoints. */
    line-height: 1.28;
    /* Compositor-only: transform, nothing else. */
    transform: translateY(110%);
    animation: rr-hero-word-in 1000ms var(--ease-soft, cubic-bezier(0.33, 1, 0.68, 1))
      calc(var(--rr-hero-start, 0ms) + var(--rr-i, 0) * 90ms) both;
  }

  @keyframes rr-hero-word-in {
    to {
      transform: translateY(0);
    }
  }

  /* Repeat view in this session: no title card, so no reason to wait for one. */
  html.rr-skip-preloader .rr-hero__word {
    animation-delay: calc(var(--rr-i, 0) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-hero__word {
      transform: none;
      animation: none;
    }
  }
</style>
