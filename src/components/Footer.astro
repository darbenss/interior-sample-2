---
import { site, nav } from '@/lib/site';
import { buildWhatsAppUrl, formatWhatsAppNumber } from '@/lib/whatsapp';

/* Oversized-typography footer. Two stacks: a quiet top section (navigation,
   contact, social) set small and widely spaced, then the studio name as large
   as it will go across the full width. No rules or boxes — the size jump and
   the charcoal ground are the only separators. */

const waHref = buildWhatsAppUrl({
  number: site.whatsappNumber,
  message: site.whatsappDefaultMessage,
  context: 'Source: site footer',
});

const year = new Date().getFullYear();
---

<footer class="rr-footer">
  <div class="rr-footer__wordmark" aria-hidden="true">
    <span data-reveal="up">
      <span>{site.studioName}</span>
    </span>
  </div>

  <div class="rr-footer__top shell">
    <nav class="rr-footer__col" aria-label="Footer">
      <p class="rr-footer__label">Studio</p>
      <ul class="rr-footer__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="rr-footer__link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="rr-footer__col">
      <p class="rr-footer__label">Contact</p>
      <ul class="rr-footer__list">
        <li>
          <a href={`mailto:${site.email}`} class="rr-footer__link">{site.email}</a>
        </li>
        <li>
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="footer-whatsapp"
            data-cta-location="footer"
            data-cta-label="Footer WhatsApp number"
            class="rr-footer__link"
          >
            {formatWhatsAppNumber(site.whatsappNumber)}
          </a>
        </li>
        {
          site.addressLines.map((line) => (
            <li class="rr-footer__muted">{line}</li>
          ))
        }
      </ul>
    </div>

    <div class="rr-footer__col">
      <p class="rr-footer__label">Social</p>
      <ul class="rr-footer__list">
        <li>
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="rr-footer__link"
          >
            Instagram
          </a>
        </li>
        <li>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="rr-footer__link"
          >
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <p class="rr-footer__legal">
      &copy; {year} {site.studioName} &nbsp;&middot;&nbsp; {site.tagline}
    </p>
  </div>
</footer>
